[Unit]
Description=BPFStack Agent
Documentation=https://github.com/moundstack/bpfstack
Wants=network-online.target
After=network-online.target

[Service]
# run as unprivileged user
User=bpf-agent
Group=bpf-agent

# Grant necessary capabilities
# CAP_BPF: Load BPF programs
# CAP_PERFMON: Trace system performance (or CAP_SYS_ADMIN on older kernels)
# CAP_NET_ADMIN: Attach BPF to network interfaces
# CAP_SYS_RESOURCE: Unlock memory for BPF maps
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_NET_ADMIN CAP_SYS_RESOURCE
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_NET_ADMIN CAP_SYS_RESOURCE

# Increase locked memory limit for BPF maps
LimitMEMLOCK=infinity

ExecStart=/usr/local/bin/bpfstack-agent --controller=localhost:50051
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
